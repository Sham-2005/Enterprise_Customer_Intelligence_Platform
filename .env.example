# Enterprise Customer Intelligence Platform (ECIP) Environment Configuration Template

# System Environment
ENVIRONMENT=development # development | staging | production
DEBUG=True
LOG_LEVEL=INFO

# Application Paths
DATASET_DIR=data_set
OUTPUT_DIR=output

# Security & Authentication
JWT_SECRET_KEY=ecip_super_secret_jwt_key_change_in_production_32bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration
# PostgreSQL Production Example: postgresql://user:password@localhost:5432/ecip_db
DATABASE_URL=sqlite:///output/ecip.db

# API & Dashboard Server Options
API_HOST=0.0.0.0
API_PORT=8000
DASHBOARD_PORT=8501
